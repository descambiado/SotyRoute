# Normalize line endings to LF in the repo; Windows checkouts get CRLF.
* text=auto eol=lf

# Force LF for these even on Windows checkouts
*.rs      text eol=lf
*.toml    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.ps1     text eol=crlf

# Binaries — no line-ending treatment
*.png     binary
*.ico     binary
*.icns    binary
*.msi     binary
*.exe     binary
